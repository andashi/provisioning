#!/usr/bin/env bash
# A stand-in for curl in case files: serves FAKE_CURL_DIR/<the whole URL with
# every / and : turned into _>, else FAKE_CURL_DIR/<its last path segment>, or
# fails like an unreachable host. The whole-URL form is for API answers, whose
# last segment (a tag) says too little. Only the options apks/*.sh use are
# understood; anything else is a broken case and says so.
out=""; url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2;;
    --retry|--max-time) shift 2;;
    -f|-s|-S|-L|-fsSL) shift;;
    http*) url="$1"; shift;;
    *) echo "fake-curl: unexpected: $1" >&2; exit 97;;
  esac
done
src="$FAKE_CURL_DIR/$(printf '%s' "$url" | tr '/:' '__')"
[ -f "$src" ] || src="$FAKE_CURL_DIR/${url##*/}"
[ -f "$src" ] || exit 22
if [ -n "$out" ]; then cp "$src" "$out"; else cat "$src"; fi
