#!/usr/bin/env bash
# andashi - steer a provisioned phone from the laptop (provisioning#7).
#
#   andashi status                what each zone holds, and what waits on this host
#   andashi diff                  what apply would do; exit 1 if anything
#   andashi apply                 bring the phone to the catalog, touching only what changed
#   andashi pull                  adopt the phone's launcher edits into the catalog
#   andashi watch                 apply to the zone in front whenever the catalog changes
#   andashi update                every running zone's updater checks the lock now;
#                                 waits for it and says what it found
#
# Editing the catalog (no phone needed; each ends in the catalog's checks):
#   andashi app add <id> --zone Z     place a catalog app in a zone
#   andashi app rm <id> --zone Z      take it out; the next apply removes it there
#   andashi theme set <key> <value> [--zone Z]
#                                     e.g. glass.tint 0.3 --zone lab; without
#                                     --zone it sets all_profiles
#
# Options (before or after the command):
#   --zone Z        only these zones; repeat or comma-separate; `current` is
#                   the one in the foreground. Default: every zone.
#   --only S        only these sections: profiles apps permissions settings
#                   vpn theme launcher updater manual. Default: whatever changed.
#   --all           may start stopped zones (evicting others) and pushes
#                   every zone's launcher whether it changed or not
#   --prune-undeclared
#                   also remove apps that are in a zone but not in the
#                   catalog - somebody's own, which diff lists as foreign
#   --dry-run       show, change nothing
#   --serial S      the device, like ADB_SERIAL
#
# A thin layer over provision/*.sh, not a second implementation: every change
# to the phone is made by the same step a full run uses, and every decision
# here reads the same records those steps write (.provision-state/). The one
# thing it adds is knowing what NOT to do - which is where the time goes:
# a full run on a phone where nothing changed took 106 s, a launcher change
# to the zone you are looking at takes seconds.
#
# The catalog is CONFIG_DIR, like everywhere else. Adopting edits from the
# phone writes into it, so that needs your own catalog, never this
# repository's template.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

CMD=""; POS=(); ZONE_ARGS=(); ONLY=""; ALL=0; PRUNE_UNDECLARED=0
while [ $# -gt 0 ]; do
  case "$1" in
    --zone)    ZONE_ARGS+=("${2:?--zone needs a value}"); shift 2;;
    --zone=*)  ZONE_ARGS+=("${1#*=}"); shift;;
    --only)    ONLY="${ONLY:+$ONLY,}${2:?--only needs a value}"; shift 2;;
    --only=*)  ONLY="${ONLY:+$ONLY,}${1#*=}"; shift;;
    --all)     ALL=1; shift;;
    --prune-undeclared) PRUNE_UNDECLARED=1; shift;;
    --dry-run) export DRY_RUN=1; shift;;
    --serial)  export ADB_SERIAL="${2:?--serial needs a value}"; shift 2;;
    -h|--help|help) usage; exit 0;;
    -*)        echo "andashi: unknown option $1 (andashi --help)" >&2; exit 2;;
    *)         if [ -z "$CMD" ]; then CMD="$1"; else POS+=("$1"); fi; shift;;
  esac
done
[ -n "$CMD" ] || { usage; exit 2; }
case "$CMD" in
  status|diff|apply|pull|watch|update) NEEDS_DEVICE=1;;
  app|theme)                    NEEDS_DEVICE=0;;
  *) echo "andashi: unknown command '$CMD' (andashi --help)" >&2; exit 2;;
esac
if [ "$NEEDS_DEVICE" = 0 ] && [ "${DRY_RUN:-0}" = 1 ]; then
  # The edit IS the preview: it changes one file you review with git diff and
  # take back with git checkout. A dry run that wrote anyway would be worse
  # than none, so it is refused rather than half-honoured.
  echo "andashi: '$CMD' edits the catalog; review the result with git diff instead of --dry-run" >&2; exit 2
fi
if [ "$NEEDS_DEVICE" = 0 ]; then
  for z in ${ZONE_ARGS[@]+"${ZONE_ARGS[@]}"}; do
    case "$z" in *current*) echo "andashi: '$CMD' edits the catalog; name the zone, 'current' needs a phone" >&2; exit 2;; esac
  done
fi

# The zone selection is resolved ONCE, here, and handed to every step as plain
# keys. `current` asked again by each step could name a different zone if the
# phone switched in between, and a run would then touch two zones for one ask.
if [ "${#ZONE_ARGS[@]}" -gt 0 ]; then
  export ZONES="${ZONE_ARGS[*]}"
fi
# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh"
[ "$NEEDS_DEVICE" = 0 ] || require_device
[ -z "${ZONES:-}" ] || export ZONES="${ZONES_RESOLVED# }"
# shellcheck source=../lib/andashi.sh
source "$ROOT/lib/andashi.sh"

THEME_FILE="$CONFIG_DIR/theming.json"
LKEY="$(jq -r '.launcher // empty' "$THEME_FILE")"
# Read by query_state in lib/launcher-state.sh.
# shellcheck disable=SC2034
PKG="$(jq -r --arg k "$LKEY" '.launchers[$k].pkg // empty' "$THEME_FILE")"
# shellcheck source=../lib/launcher-state.sh
source "$ROOT/lib/launcher-state.sh"
# shellcheck source=../lib/updater.sh
source "$ROOT/lib/updater.sh"

pending_sections() {   # $1=zone
  awk -v z="$1" '$1 == z { print $2 }' "$(pending_file)" 2>/dev/null || true
}
selected_zones() { profile_keys; }

# ---- Per-zone facts, asked once --------------------------------------------
uid_of() { resolve_uid "$1"; }
state_of() {   # $1=uid -> running|stopped|locked|missing
  [ -n "$1" ] || { printf 'missing'; return; }
  if ! user_running_uid "$1"; then printf 'stopped'; return; fi
  user_unlocked "$1" && printf 'running' || printf 'locked'
}
want_sha_of() { [ -f "$CONFIG_DIR/launcher/$1.json" ] && sha256sum "$CONFIG_DIR/launcher/$1.json" | cut -d' ' -f1 || true; }
dev_sha_of() {   # $1=uid; empty when the zone cannot answer
  query_state diagnostics "$1" 2>/dev/null | jq -r '.configSha256 // empty' 2>/dev/null || true
}
is_managed() { [ "$(profile_field "$1" type)" = "managed" ]; }
pkgs_of() {   # $1=uid [$2=-3] -> package names, space separated
  ash_ro pm list packages ${2:-} --user "$1" 2>/dev/null | tr -d '\r' | sed -n 's/^package://p' | tr '\n' ' '
}
# Sets A_missing, A_remove, A_foreign for a zone (see apps_drift).
zone_apps() {   # $1=zone $2=uid
  local rec
  rec="$(tr '\n' ' ' < "$STATE_DIR/installed/$(device_id)/$1" 2>/dev/null || true)"
  # `-u` lists every package present on the device, installed for this user
  # or not - what `pm install-existing` can bring into the zone.
  [ -n "${DEVICE_PKGS:-}" ] || DEVICE_PKGS="$(pkgs_of 0 -u)"
  eval "$(apps_drift "$(declared_pkgs "$1" | tr '\n' ' ')" "$(installable_pkgs "$1" "$DEVICE_PKGS" | tr '\n' ' ')" \
            "$(pkgs_of "$2")" "$(pkgs_of "$2" -3)" "$rec" "$(zone_system_pkgs "$1")" \
          | sed "s/^\([a-z]*\)=\(.*\)\$/A_\1='\2'/")"
}

regenerate() {
  # The generated files follow the catalog; a stale one would be pushed as if
  # it were the catalog. The generator refuses to overwrite a file that
  # changed since it wrote it, which is the answer, not an obstacle.
  #
  # Chained with && on purpose. Every caller says `regenerate || die`, and
  # inside a function called that way bash ignores `set -e`: a generator that
  # failed was followed by three checks that passed, and the function reported
  # success for a catalog that did not generate (found by
  # tests/andashi-catalog.test.sh, a glass key that does not exist).
  local out="$CONFIG_DIR/launcher"
  export CONFIG_DIR
  OUT_DIR="$out" "$ROOT/config/gen-launcher.sh" >/dev/null \
    && OUT_DIR="$out" "$ROOT/config/check-schema.sh" >/dev/null \
    && OUT_DIR="$out" "$ROOT/config/check-contacts.sh" >/dev/null \
    && OUT_DIR="$out" "$ROOT/config/check-appwidgets.sh" >/dev/null \
    && OUT_DIR="$CONFIG_DIR/updater" CERTS_DIR="$APKS_DIR/certs" "$ROOT/config/gen-updater.sh" >/dev/null
}

private_catalog() {
  [ "$(cd "$CONFIG_DIR" && pwd)" != "$ROOT/config" ]
}

# ---- status / diff -----------------------------------------------------------
# One report, two readings: status always exits 0 and says everything; diff
# prints only what is to do and exits 1 when there is any.
report() {   # $1=status|diff
  local mode="$1" todo=0 z uid st sections pend want rec dev plan line
  [ "$mode" = status ] && printf '%-8s %-5s %-8s %-34s %-12s %s\n' ZONE USER STATE LAUNCHER APPS "CHANGED SINCE LAST APPLY"
  local apps
  while read -r z; do
    uid="$(uid_of "$z")"; st="$(state_of "$uid")"
    sections="$(changed_sections "$(cat "$(applied_record "$z")" 2>/dev/null || true)" "$(zone_snapshot "$z")" | tr '\n' ' ')"
    pend="$(pending_sections "$z" | tr '\n' ' ')"
    if is_managed "$z"; then
      line="(home screen of its parent)"
    else
      want="$(want_sha_of "$z")"
      rec="$(record_field "$(sha_record "$z")" sha 2>/dev/null || true)"
      dev=""; [ "$st" = running ] && dev="$(dev_sha_of "$uid")"
      if [ "$st" = running ]; then
        plan="$(reconcile_plan "$want" "$rec" "$dev")"
      else
        # A stopped zone cannot be asked; say what the host knows.
        plan="$([ -n "$rec" ] && [ "$want" = "$rec" ] && echo "host-unchanged" || echo "host-changed")"
      fi
      case "$plan" in
        none)           line="in sync";;
        push)           line="host changed - push";;
        adopt)          line="edited on the phone - adopt";;
        conflict)       line="CONFLICT: both sides changed";;
        first)          line="never pushed from this host";;
        unknown)        line="running, but not answering";;
        host-unchanged) line="unchanged here (zone $st)";;
        host-changed)   line="changed here, waits for the zone";;
      esac
    fi
    A_missing=""; A_remove=""; A_foreign=""
    [ -n "$uid" ] && zone_apps "$z" "$uid"
    apps="$(n() { set -- $1; echo $#; }
            printf '+%s -%s ?%s' "$(n "$A_missing")" "$(n "$A_remove")" "$(n "$A_foreign")")"
    [ "$apps" = "+0 -0 ?0" ] && apps="in sync"
    if [ "$mode" = status ]; then
      printf '%-8s %-5s %-8s %-34s %-12s %s\n' "$z" "${uid:--}" "$st" "$line" "$apps" \
        "${sections:-nothing}${pend:+ | pending: $pend}"
    else
      local out=""
      [ -n "$sections" ] && out="$out  inputs changed: $sections"$'\n'
      [ -n "$pend" ]     && out="$out  pending on this host: $pend"$'\n'
      case "$line" in "in sync"|"unchanged here"*|"(home screen"*) ;; *) out="$out  launcher: $line"$'\n';; esac
      [ -n "$A_missing" ] && out="$out  apps to install: $A_missing"$'\n'
      [ -n "$A_remove" ]  && out="$out  apps to remove (no longer in the catalog): $A_remove"$'\n'
      # Named, but not a reason to exit 1 on its own: they are somebody's -
      # unless this diff previews an apply that was told to remove them.
      if [ "$PRUNE_UNDECLARED" = 1 ]; then
        [ -n "$A_foreign" ] && out="$out  apps to remove (--prune-undeclared): $A_foreign"$'\n'
      else
        [ -n "$A_foreign" ] && out="$out  not in the catalog, kept: $A_foreign"$'\n'
      fi
      [ -n "$out" ] && printf '%s\n%s' "$z" "$out"
      # Everything above is said; only what apply would act on makes it a
      # diff. Foreign apps are somebody's, so naming them is not a to-do.
      [ -n "$sections$pend$A_missing$A_remove" ] && todo=1
      [ "$PRUNE_UNDECLARED" = 1 ] && [ -n "$A_foreign" ] && todo=1
      case "$line" in "in sync"|"unchanged here"*|"(home screen"*) ;; *) todo=1;; esac
    fi
  done < <(selected_zones)
  if [ "$mode" = diff ]; then
    [ "$todo" = 0 ] && echo "nothing to do"
    return "$todo"
  fi
  local pf; pf="$(pending_file)"
  [ -s "$pf" ] && printf '\npending on this host (stopped zones): %s\n' "$(tr '\n' ',' < "$pf" | sed 's/,$//; s/,/, /g')"
  updates_report
  return 0
}

# ---- updates ------------------------------------------------------------------
# What each zone's updater says about its apps. Asked, never assumed: a zone
# whose updater does not answer is said to be silent, and a stopped zone is
# not started to ask it - its apps wait for it to run (design §8).
zone_has_updater() {   # $1=zone
  jq -e --arg p "$UPDATER_PKG" --arg k "$1" '.apps[] | select(.pkg == $p) | .profiles | index($k)' "$CONFIG_DIR/apps.json" >/dev/null
}
updates_report() {
  [ -n "$UPDATER_PKG" ] || return 0
  local z uid st json
  printf '\nupdates (%s)\n' "$UPDATER_PKG"
  while read -r z; do
    zone_has_updater "$z" || continue
    uid="$(uid_of "$z")"; st="$(state_of "$uid")"
    if [ "$st" != running ]; then printf '  %-8s %s - its apps are checked when it runs\n' "$z" "$st"; continue; fi
    if ! json="$(updater_state "$uid")"; then printf '  %-8s the updater does not answer\n' "$z"; continue; fi
    printf '  %-8s %s\n' "$z" "$(updater_summary <<<"$json")"
    updater_attention <<<"$json" | sed 's/^/             /'
  done < <(selected_zones)
}

cmd_update() {
  [ -n "$UPDATER_PKG" ] || die "the catalog has no updater (an app with role updater) - nothing to ask"
  local z uid before now i
  while read -r z; do
    zone_has_updater "$z" || continue
    uid="$(uid_of "$z")"
    [ "$(state_of "$uid")" = running ] || { skip "$z: not running - its updater checks when it runs"; continue; }
    before="$(updater_state "$uid" | jq -r '.lastCheck // empty' 2>/dev/null || true)"
    if [ "${DRY_RUN:-0}" = 1 ]; then
      printf '   [dry-run] am broadcast --user %s -n %s/%s -a %s.action.CHECK_NOW\n' "$uid" "$UPDATER_PKG" "$UPDATER_RECEIVER_CLASS" "$UPDATER_PKG"
      continue
    fi
    ash am broadcast --user "$uid" -n "$UPDATER_PKG/$UPDATER_RECEIVER_CLASS" -a "$UPDATER_PKG.action.CHECK_NOW" >/dev/null \
      || { warn "$z: CHECK_NOW could not be sent"; continue; }
    # The check runs in the background; its lastCheck moves when it is done.
    now="$before"
    for i in $(seq 1 60); do
      now="$(updater_state "$uid" | jq -r '.lastCheck // empty' 2>/dev/null || true)"
      [ -n "$now" ] && [ "$now" != "$before" ] && break
      sleep 2
    done
    if [ -z "$now" ] || [ "$now" = "$before" ]; then
      warn "$z: no new check within 2 minutes - the updater may be waiting for a network"
    else
      ok "$z: checked at $now"
    fi
  done < <(selected_zones)
  updates_report
}

# ---- pull ------------------------------------------------------------------------
cmd_pull() {
  private_catalog || die "pull writes into the catalog, and CONFIG_DIR is this repository's template.
   Point it at your own:  CONFIG_DIR=/path/to/config andashi pull"
  "$ROOT/provision/45-launcher-config.sh" --pull
  regenerate
}

# ---- apply ------------------------------------------------------------------------
# Per zone: which sections changed since this host last applied to it (or
# --only), plus what a stopped zone still owes. Per step: the zones that need
# it. Each step then runs once, in chain order, for exactly those zones - so a
# palette change in Lab starts nothing but Lab, and a wallpaper change in the
# zone you are looking at touches that zone and no other.
cmd_apply() {
  local t0 z s st uid want rec dev plan rc=0
  local -A ZSTEPS=()
  local adopt=() conflict=()
  t0="$(date +%s)"

  if [ -n "$ONLY" ]; then
    for s in ${ONLY//,/ }; do
      section_steps "$s" >/dev/null || die "--only: '$s' is not a section ($SECTIONS)"
    done
  fi
  while read -r z; do
    local secs=()
    if [ -n "$ONLY" ]; then
      read -ra secs <<<"${ONLY//,/ }"
    else
      mapfile -t secs < <(changed_sections "$(cat "$(applied_record "$z")" 2>/dev/null || true)" "$(zone_snapshot "$z")"
                           pending_sections "$z")
      # Every apply starts with a pull (#7), so a zone where nothing changed on
      # this host is still asked - if it is running - whether the phone
      # changed. One query per running zone; a stopped one cannot have been
      # edited since it stopped, and the step's guard meets it when it runs.
      # The phone's side of the apps: something the catalog names that is not
      # there, or something it stopped naming that still is. Asked of every
      # zone that exists - the package manager answers for stopped ones too.
      local zuid; zuid="$(uid_of "$z")"
      if [ -n "$zuid" ]; then
        A_missing=""; A_remove=""; A_foreign=""
        zone_apps "$z" "$zuid"
        if [ -n "$A_missing$A_remove" ] || { [ "$PRUNE_UNDECLARED" = 1 ] && [ -n "$A_foreign" ]; }; then
          secs+=(apps)
        fi
      fi
      if ! is_managed "$z" && [ "$(state_of "$(uid_of "$z")")" = running ]; then
        case "$(reconcile_plan "$(want_sha_of "$z")" \
                  "$(record_field "$(sha_record "$z")" sha 2>/dev/null || true)" \
                  "$(dev_sha_of "$(uid_of "$z")")")" in
          adopt|conflict) secs+=(launcher);;
        esac
      fi
    fi
    [ "${#secs[@]}" -gt 0 ] || continue
    mapfile -t secs < <(printf '%s\n' "${secs[@]}" | awk '!seen[$0]++')
    ZSTEPS[$z]=" $(steps_for_sections "${secs[@]}" | tr '\n' ' ')"
    log "$z: ${secs[*]}"
  done < <(selected_zones)

  if [ "${#ZSTEPS[@]}" -eq 0 ]; then
    ok "nothing changed since the last apply${ZONES:+ in $ZONES}"
    return 0
  fi
  zones_for_step() {   # $1=step -> zone keys, in catalog order, space separated
    local k out=""
    while read -r k; do
      case "${ZSTEPS[$k]:-}" in *" $1 "*) out="$out $k";; esac
    done < <(selected_zones)
    printf '%s' "${out# }"
  }

  if [ -n "$(zones_for_step 45-launcher-config)" ]; then
    regenerate || die "the catalog does not generate cleanly - fix it before applying"

    # Pull before push (#7): the phone is the other half of the configuration,
    # and an edit made there must not be lost because the host pushed. Only a
    # running zone can be asked; a stopped one meets the step's own guard the
    # next time it runs.
    for z in $(zones_for_step 45-launcher-config); do
      is_managed "$z" && continue
      uid="$(uid_of "$z")"; st="$(state_of "$uid")"
      [ "$st" = running ] || continue
      want="$(want_sha_of "$z")"
      rec="$(record_field "$(sha_record "$z")" sha 2>/dev/null || true)"
      dev="$(dev_sha_of "$uid")"
      plan="$(reconcile_plan "$want" "$rec" "$dev")"
      case "$plan" in
        adopt)    adopt+=("$z");;
        conflict) conflict+=("$z");;
      esac
    done
    if [ "${#adopt[@]}" -gt 0 ] && [ "${DRY_RUN:-0}" = 1 ]; then
      # Adopting writes the catalog; a dry run changes nothing, there either.
      log "[dry-run] would adopt what was edited on the phone: ${adopt[*]}"
    elif [ "${#adopt[@]}" -gt 0 ]; then
      if private_catalog; then
        log "edited on the phone, adopting before pushing: ${adopt[*]}"
        ZONES="${adopt[*]}" "$ROOT/provision/45-launcher-config.sh" --pull
        regenerate || die "the adopted edit does not generate cleanly - see git diff in $CONFIG_DIR"
      else
        warn "edited on the phone: ${adopt[*]} - the template cannot adopt it; point CONFIG_DIR at your own catalog"
      fi
    fi
    # A zone in conflict is left alone - by EVERY step, not only the launcher
    # one: a settings or theme change applied to it while its launcher waits
    # for a person would be half an apply to a zone we said we left alone.
    # Both sides are named below; every other zone goes ahead.
    for z in ${conflict[@]+"${conflict[@]}"}; do
      unset "ZSTEPS[$z]"
    done
  fi

  local env_mode=(NO_START=1 ONLY_CHANGED=1) zs st_rc step_fail=0
  [ "$ALL" = 1 ] && env_mode=(NO_START=0 ONLY_CHANGED=0)
  env_mode+=(PRUNE_UNDECLARED="$PRUNE_UNDECLARED")
  for s in "${STEP_ORDER[@]}"; do
    zs="$(zones_for_step "$s")"
    [ -n "$zs" ] || continue
    printf '\n%s\n' "$(_c '1;35' "===== $s ($zs) =====")"
    st_rc=0
    env ZONES="$zs" "${env_mode[@]}" "$ROOT/provision/$s.sh" || st_rc=$?
    [ "$st_rc" = 0 ] || { step_fail=1; warn "$s failed (exit $st_rc)"; }
  done
  rc="$step_fail"
  [ "${#conflict[@]}" -eq 0 ] || { report_conflicts "${conflict[@]}"; rc=1; }

  # Recorded only after a run that went through: a zone recorded as applied
  # after a failed step would never be retried. What a stopped zone still owes
  # is in the pending file, not here; a zone in conflict is not recorded.
  # --only ran some sections, and the record is of whole zones: writing it
  # would mark the sections that did NOT run as applied, and they would never
  # be delivered. So a partial apply leaves the record alone; the next apply
  # runs what is still outstanding (the parts already applied converge as
  # no-ops).
  if [ "$step_fail" = 0 ] && [ -z "$ONLY" ]; then
    for z in "${!ZSTEPS[@]}"; do
      case " ${conflict[*]:-} " in *" $z "*) continue;; esac
      record_applied "$z"
    done
  fi
  printf '\n'
  if [ "$rc" = 0 ]; then ok "applied in $(( $(date +%s) - t0 ))s"
  else warn "apply finished with failures in $(( $(date +%s) - t0 ))s"; fi
  return "$rc"
}

report_conflicts() {
  local z uid eff mism
  printf '\n'
  for z in "$@"; do
    uid="$(uid_of "$z")"
    eff="$(query_state config "$uid" 2>/dev/null || true)"
    mism="$(jq -r -n --argjson eff "${eff:-null}" --slurpfile want "$CONFIG_DIR/launcher/$z.json" \
              -f "$ROOT/lib/readback-compare.jq" 2>/dev/null || true)"
    warn "$z: changed on the phone AND here since the last agreement - left alone"
    warn "$z: they differ in: ${mism:-<could not compare>}"
    warn "$z: keep the phone's:  andashi pull --zone $z   (then re-apply your change on top)"
    warn "$z: keep this host's:  pull, revert the pulled lines in $CONFIG_DIR, apply"
  done
}

# ---- editing the catalog ------------------------------------------------------
# For people and for agents alike: the change lands in CONFIG_DIR, the same
# checks as `make check` run over it, and nothing touches a phone. Applying is
# a separate, deliberate step.
catalog_checks() {
  regenerate || { warn "the catalog no longer generates cleanly - see above"; return 1; }
  CONFIG_DIR="$CONFIG_DIR" "$ROOT/config/check-invariants.sh" >/dev/null || return 1
  ok "catalog checks pass - review with git diff in $CONFIG_DIR; then look at 'andashi diff' and run 'andashi apply'"
}
# An edit the checks refuse is taken back: a command that leaves the catalog
# in a state `make check` rejects hands the next person - or the agent that
# ran it - a broken file and a message they may not have read.
KEEP="$(mktemp -d)"; trap 'rm -rf "$KEEP"' EXIT
catalog_keep() { cp "$CONFIG_DIR/apps.json" "$CONFIG_DIR/theming.json" "$KEEP/"; }
catalog_restore_and_die() {   # $1=why
  cp "$KEEP/apps.json" "$KEEP/theming.json" "$CONFIG_DIR/"
  regenerate >/dev/null 2>&1 || true
  die "$1 - the catalog is as it was before this command"
}
catalog_commit_or_restore() {
  catalog_checks && return 0
  cp "$KEEP/apps.json" "$KEEP/theming.json" "$CONFIG_DIR/"
  regenerate >/dev/null 2>&1 || true
  die "refused - the catalog is as it was before this command"
}
edit_json() {   # $1=file $2=jq program, rest=jq args; atomic, and only if jq succeeds
  local f="$1" prog="$2"; shift 2
  jq --indent 2 "$@" "$prog" "$f" > "$f.new" && mv "$f.new" "$f" || { rm -f "$f.new"; return 1; }
}
cmd_app() {
  local verb="${POS[0]:-}" id="${POS[1]:-}" z
  [ -n "$verb" ] && [ -n "$id" ] && [ -n "${ZONES:-}" ] \
    || die "usage: andashi app add|rm <id> --zone Z"
  jq -e --arg id "$id" '.apps[] | select(.id == $id)' "$CONFIG_DIR/apps.json" >/dev/null \
    || die "no app '$id' in $CONFIG_DIR/apps.json - a new app needs its own entry first (package, source, net)"
  catalog_keep
  for z in $ZONES; do
    case "$verb" in
      add) edit_json "$CONFIG_DIR/apps.json" '(.apps[] | select(.id == $id) | .profiles) |= ((. // []) + [$z] | unique)' \
             --arg id "$id" --arg z "$z" || catalog_restore_and_die "could not place $id in $z"
           ok "$id placed in $z";;
      rm)  edit_json "$CONFIG_DIR/apps.json" '(.apps[] | select(.id == $id) | .profiles) |= ((. // []) - [$z])' \
             --arg id "$id" --arg z "$z" || catalog_restore_and_die "could not take $id out of $z"
           ok "$id taken out of $z - the next apply removes it there";;
      *)   die "andashi app: '$verb' is neither add nor rm";;
    esac
  done
  catalog_commit_or_restore
}
cmd_theme() {
  local verb="${POS[0]:-}" key="${POS[1]:-}" val="${POS[2]:-}" path z
  [ "$verb" = set ] && [ -n "$key" ] && [ "${#POS[@]}" -ge 3 ] \
    || die "usage: andashi theme set <key> <value> [--zone Z]   e.g. glass.tint 0.3"
  # A value that parses as JSON is JSON (0.3, true, "x"); anything else is a string.
  # Whether it parses, not whether it is truthy: `jq -e` would call a valid
  # `false` a failure and store the string "false".
  jq -n --argjson v "$val" 'true' >/dev/null 2>&1 || val="$(jq -cn --arg v "$val" '$v')"
  path="$(jq -cn --arg k "$key" '$k | split(".")')"
  catalog_keep
  if [ -z "${ZONES:-}" ]; then
    edit_json "$CONFIG_DIR/theming.json" 'setpath(["all_profiles"] + $p; $v)' --argjson p "$path" --argjson v "$val" \
      || catalog_restore_and_die "could not set all_profiles.$key"
    ok "all_profiles.$key = $val"
  else
    for z in $ZONES; do
      edit_json "$CONFIG_DIR/theming.json" 'setpath(["per_profile", $z] + $p; $v)' \
        --arg z "$z" --argjson p "$path" --argjson v "$val" \
        || catalog_restore_and_die "could not set per_profile.$z.$key"
      ok "per_profile.$z.$key = $val"
    done
  fi
  catalog_commit_or_restore
}

# ---- watch ------------------------------------------------------------------------
# The edit-and-look loop without typing the apply: every time an input of the
# zone in front changes, apply to that zone. Polls instead of inotify, because
# editors save by rename and wallpaper paths live outside CONFIG_DIR; hashing
# one zone's inputs costs a few milliseconds. The zone is asked for again on
# every change, so switching zones on the phone moves the watch with you.
cmd_watch() {
  local fixed="${ZONES:-}" last="" now
  # `--zone current` means "whatever is in front", every time - not the zone
  # that happened to be in front when watch started. It was resolved to a key
  # above like every selection, so it is recognised from the arguments here.
  [ "${ZONE_ARGS[*]:-}" = current ] && fixed=""
  fixed="${fixed// /,}"
  # What watch was started with, every apply gets: --all, --only and
  # --prune-undeclared belong to the loop, not to its first round.
  local fwd=()
  [ "$ALL" = 1 ] && fwd+=(--all)
  [ -n "$ONLY" ] && fwd+=(--only "$ONLY")
  [ "$PRUNE_UNDECLARED" = 1 ] && fwd+=(--prune-undeclared)
  snap() {   # the inputs of the watched zones, as one hash
    local z zs="$fixed"
    zs="${zs//,/ }"
    [ -n "$zs" ] || zs="$(ZONES=current bash -c 'source "$0/lib/common.sh"; printf %s "$ZONES_RESOLVED"' "$ROOT" 2>/dev/null)"
    for z in $zs; do zone_snapshot "$z"; done | sha256sum
  }
  log "watching $CONFIG_DIR${fixed:+ for $fixed} - Ctrl-C to stop"
  last="$(snap)"
  while :; do
    sleep 1
    now="$(snap)"
    [ "$now" != "$last" ] || continue
    sleep 0.3   # an editor writing in two steps
    now="$(snap)"
    # What this apply is FOR is the state before it starts. A save that
    # lands while it runs is not in it, so it is not acknowledged here: the
    # next poll sees it differ from $last and applies again.
    last="$now"
    "$0" apply --zone "${fixed:-current}" ${fwd[@]+"${fwd[@]}"} || true
    log "watching again"
  done
}

case "$CMD" in
  app)    cmd_app;;
  theme)  cmd_theme;;
  watch)  cmd_watch;;
  update) cmd_update;;
  status) report status;;
  diff)   report diff;;
  pull)   cmd_pull;;
  apply)  cmd_apply;;
esac
