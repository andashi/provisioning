{
  "appearance": {
    "glass": {
      "blur": 24,
      "contrast": "medium",
      "radius": 28,
      "searchWallpaperBlur": true,
      "tint": 0.12,
      "wallpaperBlur": false
    },
    "wallpaper": {
      "image": "home.jpg",
      "target": "both"
    }
  },
  "home": {
    "favorites": [
      {
        "packageName": "com.android.dialer"
      },
      {
        "packageName": "app.vanadium.browser"
      }
    ],
    "grid": {
      "columns": 4,
      "labels": true,
      "layouts": {
        "fold": {
          "items": [
            {
              "h": 7,
              "id": "favorites",
              "w": 1,
              "widget": "favorites",
              "x": 7,
              "y": 0
            }
          ]
        },
        "phone": {
          "items": [
            {
              "h": 1,
              "id": "favorites",
              "w": 4,
              "widget": "favorites",
              "x": 0,
              "y": 5
            }
          ]
        }
      },
      "locked": false
    },
    "searchBar": {
      "position": "bottom"
    },
    "widgets": {
      "enabled": true
    }
  },
  "icons": {
    "enforceThemed": true,
    "pack": "app.lawnchair.lawnicons",
    "themed": true
  },
  "schemaVersion": 2,
  "search": {
    "contacts": true
  }
}
